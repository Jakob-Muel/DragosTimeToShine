class_name UiTokens
extends RefCounted

## The interface borrows its palette from the dragon illustrations: warm paper,
## berry pink, moss green and a soft aubergine instead of hard black outlines.
const PINK := Color("#e75d91")
const PINK_DARK := Color("#9e3f68")
const CREAM := Color("#fff1d2")
const CREAM_DEEP := Color("#f3d9ae")
const SKY := Color("#78d6ed")
const SKY_PALE := Color("#dff3ef")
const MINT := Color("#a9d69a")
const GREEN := Color("#4f956c")
const INK := Color("#382b3d")
const INK_SOFT := Color("#6f5a70")
